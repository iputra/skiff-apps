PORT=4000
# URL the browser uses to reach this server (attachment download links are built from it).
PUBLIC_URL=http://localhost:4000
# Comma-separated origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:4200,http://localhost:1212
# Defaults to ./data/skemail.sqlite and ./data/attachments
# DATA_DIR=./data
# Set to true behind HTTPS (cookies become Secure; SameSite=None).
COOKIE_SECURE=false
# Signs attachment download links. Random per process when unset.
# LINK_SECRET=

# --- Mail server (email to/from other servers) ---
# Domains whose mailboxes live here; accounts must use these domains (e.g. alice@example.com).
MAIL_DOMAINS=skiff.local
# Hostname of this mail server: target of the MX record, and what reverse DNS (PTR) of the IP must return.
# MAIL_HOSTNAME=mail.skiff.local
# Inbound SMTP (MX). Use 25 in production (needs root or CAP_NET_BIND_SERVICE); 0 disables it.
SMTP_PORT=2525
# SMTP_HOST=0.0.0.0
# STARTTLS certificate for inbound SMTP (e.g. Let's Encrypt for MAIL_HOSTNAME). Self-signed when unset.
# SMTP_TLS_KEY_FILE=/etc/letsencrypt/live/mail.example.com/privkey.pem
# SMTP_TLS_CERT_FILE=/etc/letsencrypt/live/mail.example.com/fullchain.pem
# MAX_MESSAGE_BYTES=31457280
# Set to false to keep outgoing mail queued (e.g. while DNS is not ready).
OUTBOUND_ENABLED=true
# OUTBOUND_SMTP_PORT=25
# DKIM signing key; created automatically on first start. Publish it with: yarn workspace skemail-server dns
# DKIM_SELECTOR=skemail
# DKIM_KEY_FILE=./data/dkim-private.pem
# For local testing only: deliver some domains to fixed hosts instead of looking up MX records.
# MX_OVERRIDES=external.test=127.0.0.1:2626
