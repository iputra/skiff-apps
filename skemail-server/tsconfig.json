{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "skiff-crypto": ["../libs/skiff-crypto/src/index.ts"],
      "skiff-graphql": ["../libs/skiff-graphql/src/index.ts"],
      "skiff-utils": ["../libs/skiff-utils/src/index.ts"]
    }
  },
  "include": ["src", "scripts", "test"]
}
