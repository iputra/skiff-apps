FROM node:22-bookworm AS base

WORKDIR /app

COPY . .

RUN yarn install

# Shared libraries, in dependency order. tsc errors are expected; only dist/ matters.
# esbuild may hang after finishing, so each build is bounded by a timeout.
RUN set -e; for lib in skiff-utils skiff-mail-protos skiff-graphql skiff-crypto skiff-crypto-v2 \
           skiff-front-graphql skiff-front-search nightwatch-ui skiff-front-utils; do \
      echo "=== building $lib"; \
      (cd libs/$lib && timeout 900 yarn node build.js || true); \
      test -d libs/$lib/dist/cjs && test -d libs/$lib/dist/esm || { echo "build failed: $lib"; exit 1; }; \
    done

# --- skemail-server (GraphQL + SMTP)
FROM base AS server
EXPOSE 4000 2525
CMD ["yarn", "workspace", "skemail-server", "start"]

# --- skemail-web production bundle
FROM base AS web-build
ARG SKEMAIL_API_BASE_URL
ENV SKEMAIL_API_BASE_URL=$SKEMAIL_API_BASE_URL \
    NODE_OPTIONS=--max-old-space-size=8192
RUN cd skemail-web && yarn build-main && yarn package-push-sw

FROM nginx:alpine AS web
COPY docker/skemail-web.nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=web-build /app/skemail-web/src/dist /usr/share/nginx/html/mail
EXPOSE 80
