# Deployment values for docker-compose.yml. Copy to .env (not committed) and fill in.

# Where the browser reaches the web app and the API (both served over HTTPS by the reverse proxy).
SKEMAIL_WEB_URL=https://example.com
SKEMAIL_API_URL=https://api.example.com

# Domains whose mailboxes live here, and the MX host name (DNS-only A record; PTR of the server IP must match).
MAIL_DOMAINS=example.com
MAIL_HOSTNAME=mx.example.com

# Accounts allowed to create other accounts on MAIL_DOMAINS (comma-separated). Empty: nobody.
ADMIN_USERS=

# Docker volume holding the SQLite database, attachments and the DKIM key.
SKEMAIL_DATA_VOLUME=skemail-data

# OUTBOUND_ENABLED=true
# MTA_STS_MODE=testing
